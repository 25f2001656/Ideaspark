# ChargeShare Environment Configuration
# Leave blank to run automatically in full Seeded Demo Mode (IndexedDB + Local Signer Simulation)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret for signing booking QR tokens (NEVER expose with NEXT_PUBLIC_)
BOOKING_TOKEN_PRIVATE_SECRET=chargeshare_server_only_hmac_or_ecdsa_secret_key_change_in_prod
NEXT_PUBLIC_BOOKING_TOKEN_PUBLIC_KEY=chargeshare_pub_v1_mangaluru_demo

# Local SQLite authentication
AUTH_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@chargeshare.local
ADMIN_PASSWORD=replace_with_a_strong_admin_password
